{
	"name": "woocommerce/woocommerce-square",
	"description": "WooCommerce Square",
	"homepage": "https://woocommerce.com/products/woocommerce-square/",
	"license": "GPL-3.0-or-later",
	"minimum-stability": "dev",
	"prefer-stable": true,
	"require": {
		"square/square": "40.0.0.20250123"
	},
	"require-dev": {
		"woocommerce/woocommerce-sniffs": "1.0.0",
		"sirbrillig/phpcs-changed": "^2.11.1",
		"phpunit/phpunit": "^9.6",
		"yoast/phpunit-polyfills": "^2.0"
	},
	"scripts": {
		"phpcs": [
			"vendor/bin/phpcs"
		],
		"test-unit": [
			"vendor/bin/phpunit --configuration tests/php/phpunit.xml.dist"
		]
	},
	"archive": {
		"exclude": [
			"/assets/blocks",
			"/assets/css/**/*.scss",
			"/assets/js/**/*.js",
			"/node_modules",
			"!/build",
			"!/i18n",
			"!/vendor",
			"!/assets/js/**/*.min.js",
			"!/assets/css/**/*.min.css",
			"*.zip",
			"/vendor/apimatic/*/tests/**",
			"/vendor/apimatic/*/.*",
			"/vendor/square/square/tests/**",
			"/vendor/square/square/doc/**",
			"/vendor/square/square/.*"
		]
	},
	"extra": {
		"installer-disable": true
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
